{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|assets/|.*\\.(?:svg|png|jpg|ico|xml|txt)).*)",
      "destination": "/index.html"
    }
  ]
}
